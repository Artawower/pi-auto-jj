{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@mariozechner/pi-coding-agent": ["./test-stubs/pi-coding-agent.ts"]
    }
  },
  "include": [
    "extensions/**/*",
    "test-stubs/**/*",
    "vitest.config.ts"
  ]
}
